public class TUMLibrary {
    private String name;
    private Section[] sections;

    public TUMLibrary(String name) {
        this.name = name;
        this.sections = new Section[5];
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public Section[] getSections() {
        return sections;
    }

    public boolean containsBookId(String bookId) {
        if (bookId == null) return false;

        for (Section section : sections) {
            if (section != null && section.getShelves() != null) {
                for (Shelf shelf : section.getShelves()) {
                    if (shelf != null && shelf.getBooks() != null) {
                        for (Book book : shelf.getBooks()) {
                            if (book != null && bookId.equals(book.getId())) {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        return false;
    }

    public boolean addSection(Section section) {
        if (section == null) return false;

        for (int i = 0; i < sections.length; i++) {
            if (sections[i] == null) {
                sections[i] = section;
                return true;
            }
        }
        return false;
    }

    public boolean validateNewBook(Book book, String expectedGenre) {
        if (book == null || book.getId() == null) {
            return false;
        }

        if (containsBookId(book.getId())) {
            return false;
        }

        for (Section section : sections) {
            if (section != null && section.getSectionName() != null 
                    && section.getSectionName().equalsIgnoreCase(expectedGenre)) {
                return section.addToShelf(book);
            }
        }

        return false;
    }

    public void sort() {
        for (Section section : sections) {
            if (section != null && section.getShelves() != null) {
                for (Shelf shelf : section.getShelves()) {
                    if (shelf != null && shelf.getBooks() != null) {
                        Book[] books = shelf.getBooks();
                        
                        for (int i = 0; i < books.length - 1; i++) {
                            for (int j = 0; j < books.length - 1 - i; j++) {
                                if (books[j] != null && books[j + 1] != null
                                        && books[j].getTitle() != null
                                        && books[j + 1].getTitle() != null
                                        && books[j].getTitle().compareTo(books[j + 1].getTitle()) > 0) {
                                    
                                    Book tmp = books[j];
                                    books[j] = books[j + 1];
                                    books[j + 1] = tmp;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}